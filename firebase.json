{
  "hosting": {
    "public": "site",
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "/d/**", "headers": [
        { "key": "Cache-Control", "value": "private, max-age=86400" } ] }
    ],
    "redirects": [ { "source": "/", "destination": "/en/", "type": 302 } ]
  },
  "firestore": { "rules": "firestore.rules", "database": "(default)" },
  "auth": { "providers": { "emailPassword": true } }
}
