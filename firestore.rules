rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with an email whose ownership was proven (email link).
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() { return verified() && me() == 'glsvyatoslav@gmail.com'; }
    // Black list (deny/<email> or deny/@domain.com): never allowed, can't even leave a request.
    function denied() {
      return exists(/databases/$(database)/documents/deny/$(me()))
        || exists(/databases/$(database)/documents/deny/$('@' + me().split('@')[1]));
    }
    function strikesDoc() { return /databases/$(database)/documents/strikes/$(me()); }
    function notBlocked() { return !exists(strikesDoc()) || get(strikesDoc()).data.count < 3; }
    // On the access list kept by the admin (allow/<email>) and not blocked for screenshots, or the admin.
    function allowed() {
      return verified() && (isAdmin() || (exists(/databases/$(database)/documents/allow/$(me())) && notBlocked() && !denied()));
    }

    // Deck HTML for viewers (slides, no speaker notes). Written only by publish.py with admin credentials.
    match /decks/{lang} {
      allow read: if allowed();
    }
    // The same deck with speaker notes: admin only.
    match /decksFull/{lang} {
      allow read: if isAdmin();
    }

    // Screenshot / print attempts, counted by the viewer page. At 3 the deck stops opening;
    // only the admin can reset (delete) the count.
    match /strikes/{email} {
      allow get: if verified() && email == me();
      allow read, delete: if isAdmin();
      allow create: if verified() && email == me()
        && request.resource.data.keys().hasOnly(['email', 'count', 'at', 'kind'])
        && request.resource.data.email == me() && request.resource.data.count == 1
        && request.resource.data.at == request.time && request.resource.data.kind is string;
      allow update: if verified() && email == me()
        && request.resource.data.keys().hasOnly(['email', 'count', 'at', 'kind'])
        && request.resource.data.email == me() && request.resource.data.count == resource.data.count + 1
        && request.resource.data.at == request.time && request.resource.data.kind is string;
    }

    // Access list: managed from /admin/.
    match /allow/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'note', 'addedAt'])
        && request.resource.data.email == email
        && request.resource.data.note is string && request.resource.data.note.size() < 200;
    }

    match /deny/{entry} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['entry', 'note', 'addedAt'])
        && request.resource.data.entry == entry;
    }

    // Someone signed in but is not on the list: one request per email, shown to the admin.
    match /requests/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if verified() && email == me() && !denied()
        && request.resource.data.keys().hasOnly(['email', 'lang', 'at'])
        && request.resource.data.email == me()
        && request.resource.data.at == request.time
        && request.resource.data.lang in ['en', 'ru'];
    }

    // One entry per opening of the deck; the page then adds what was seen (seconds per slide).
    match /views/{id} {
      allow read, delete: if isAdmin();
      allow update: if verified() && resource.data.email == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slides', 'seen', 'dur', 'last'])
        && request.resource.data.slides is map && request.resource.data.slides.size() <= 60
        && request.resource.data.seen is int && request.resource.data.dur is int
        && request.resource.data.last == request.time;
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['email', 'lang', 'at', 'ua', 'code'])
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.email == me()
        && request.resource.data.at == request.time
        && request.resource.data.lang in ['en', 'ru']
        && request.resource.data.ua is string && request.resource.data.ua.size() < 400;
    }
  }
}
